# Cinomnia environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Single-owner login (no registration, no database)
APP_USERNAME=your_username

# Prefer a hash. Generate one with:
#   php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
APP_PASSWORD_HASH=

# Optional plaintext instead of a hash (fine for a private local app)
# APP_PASSWORD=change-me

# The Movie Database API key
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Set to false on hosts with broken CA bundles (common on free shared hosting)
TMDB_SSL_VERIFY=true

# Set to true temporarily to show detailed TMDB/cURL errors in the UI
APP_DEBUG=false

# HTTPS is forced via .htaccess on InfinityFree (local http://localhost is excluded).
# No SITE_URL is required — BASE_URL is path-relative and works on both http and https.
