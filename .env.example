# Cinomnia environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MySQL database
DB_HOST=localhost
DB_NAME=cinomnia
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# The Movie Database API key
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
